# ─────────────────────────────────────────────────────────────────────────────
# Beyond Labels — Environment Variables
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env.local
#   2. Fill in real values in .env.local
#   3. .env.local is gitignored — it will NEVER be committed
#   4. In Vercel: add these under Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────


# ── Open Food Facts API ───────────────────────────────────────────────────────
# Base URL for the Open Food Facts product lookup API.
# The free public API requires no key. Override only if you are self-hosting
# a mirror or using a staging environment.
OFF_API_BASE_URL=https://world.openfoodfacts.org/api/v0/product

# Contact email sent in the User-Agent header to Open Food Facts.
# OFF asks apps to identify themselves so they can reach you if needed.
# Replace with a real address before deploying to production.
OFF_USER_AGENT_EMAIL=your-email@example.com


# ── App URL (used for absolute URL generation) ────────────────────────────────
# Set to your Vercel deployment URL in production.
# Example: https://beyond-labels.vercel.app
# Leave blank in local development (Next.js uses http://localhost:3000 by default).
NEXT_PUBLIC_APP_URL=


# ── Anthropic AI (for /api/explain — AI verdict explanations) ────────────────
# Get your key from https://console.anthropic.com/
# In Vercel: Project → Settings → Environment Variables → add ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=your-anthropic-api-key-here


# ── Future: Barcode Lookup Fallback (not yet wired) ──────────────────────────
# If you add a secondary barcode database (e.g. Nutritionix, Edamam, Barcodelookup),
# put the API key here. Not currently used.
# BARCODE_API_KEY=


# ── Sentry (error monitoring) ─────────────────────────────────────────────────
# Get your DSN from sentry.io → your project → Settings → Client Keys (DSN).
# NEXT_PUBLIC_ because it's read client-side too (sentry.client.config.js) —
# a DSN is a write-only ingest address, safe to expose to the browser.
# See CLAUDE.md → "Error Monitoring" for what's wired in and the
# environment-tagging scheme (development / preview / production).
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional — only needed if you want source maps uploaded to Sentry on
# build (better stack traces in the dashboard). Get these from
# sentry.io → Settings → Organization/Project, and an auth token from
# Settings → Account → API → Auth Tokens (needs project:releases scope).
# Without these three set, the build still succeeds — source map upload is
# silently skipped, not required for error capture to work.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
